{
  "name": "openchamber-pi-connector",
  "version": "0.1.0",
  "description": "OpenCode-API-compatible adapter that lets OpenChamber drive the pi coding agent",
  "type": "module",
  "license": "MIT",
  "bin": {
    "openchamber-pi": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "probe": "tsx contrib/probe.ts",
    "smoke": "tsx contrib/smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.31",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.14",
    "typescript": "^7.0.2"
  }
}
